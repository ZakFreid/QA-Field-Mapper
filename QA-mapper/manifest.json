{
    "manifest_version": 3,
    "name": "QA Field Mapper",
    "version": "0.4.0",
    "description": "Связывает DOM-поля с JSON-параметрами бэкенда.",
    "permissions": ["storage", "activeTab", "tabs"],
    "action": { "default_popup": "popup.html" },
    "background": { "service_worker": "background.js" },
    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["inject.js"],
        "run_at": "document_start",
        "world": "MAIN"
    },
    {
        "matches": ["<all_urls>"],
        "js": ["content.js", "scanner.js"],
        "run_at": "document_start",
        "all_frames": true
    }
    ]
}